# Configuración de los tres roles del pipeline (atacante / solver / juez).
# Cada rol debe usar una familia de modelo DISTINTA para evitar circularidad.
# Proveedores soportados: gemini | openai_compatible

# === Rol ATACANTE (genera los ataques adversariales) ===
ATTACKER_PROVIDER=openai_compatible
ATTACKER_BASE_URL=https://api.groq.com/openai/v1
ATTACKER_MODEL=llama-3.3-70b-versatile
ATTACKER_API_KEY=tu_api_key_de_groq

# === Rol SOLVER (modelo evaluado: resuelve las tareas) ===
SOLVER_PROVIDER=gemini
SOLVER_MODEL=gemini-2.5-flash
# Para provider gemini, la API key se toma de SOLVER_API_KEY o, en su defecto, de GEMINI_API_KEY.
GEMINI_API_KEY=tu_api_key_de_gemini
# SOLVER_API_KEY=

# === Rol JUEZ (valida ataques y evalúa la calidad del razonamiento) ===
JUDGE_PROVIDER=openai_compatible
JUDGE_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=deepseek/deepseek-chat
JUDGE_API_KEY=tu_api_key_de_openrouter

# === Dataset original (lo provee el docente) ===
# Descomentar para usar una ruta distinta a dataset/og_dataset.json
# ORIGINAL_DATASET_PATH=dataset/og_dataset.json
